Bootstrap: docker
From: ubuntu:24.04

# %files
#     . /app

%environment
    export PATH="/opt/conda/envs/aimcu/bin:/opt/conda/bin:$PATH"
    export CONDA_DEFAULT_ENV="aimcu"
    export CONDA_PREFIX="/opt/conda/envs/aimcu"
    export R_HOME="/opt/conda/envs/aimcu/lib/R"
    export LANG=C
    export LC_ALL=C
    export R_LIBS_USER=/tmp/aimcu-r-library
    export NO_PROXY="localhost,127.0.0.1,::1"
    export no_proxy="localhost,127.0.0.1,::1"

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        wget \
        ca-certificates \
        git \
        bzip2

    wget -qO /tmp/miniforge.sh \
        "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-$(uname -m).sh"
    bash /tmp/miniforge.sh -b -p /opt/conda
    rm /tmp/miniforge.sh

    . /opt/conda/etc/profile.d/conda.sh

    # Create a conda environment
    conda create -n aimcu --override-channels -c conda-forge -y \
        python=3.10 \
        pip \
        r-base \
        rpy2=3.5.1 \
        c-compiler \
        cxx-compiler \
        fortran-compiler \
        make \
        pkg-config \
        zlib

    conda activate aimcu
    export R_HOME="$CONDA_PREFIX/lib/R"

    # setup R configs
    echo "r <- getOption('repos'); r['CRAN'] <- 'https://cloud.r-project.org'; options(repos = r);" \
        >> "$R_HOME/etc/Rprofile.site"

    Rscript -e "install.packages(c('ggplot2', 'hexbin', 'lazyeval', 'cusumcharter', 'RcppCNPy', 'spc'))"

    # Clone the repository. If not, use local repository, and put this Dockerfile inside it and comment the below two commands
    cd /
    git clone --branch "apptainer" --single-branch \
        https://github.com/DIDSR/AIM-CU.git /app

    cd /app/src/package
    python3 -m pip install --use-pep517 --no-cache-dir \
        --break-system-packages --upgrade -r /app/requirements.txt
    python3 -m pip install --no-cache-dir --break-system-packages \
        --upgrade gradio gradio_client

    conda clean --all -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    set -eu
    export R_LIBS_USER=/tmp/aimcu-r-library
    mkdir -p "$R_LIBS_USER"
    cd /app/src/package
    exec /opt/conda/envs/aimcu/bin/python app.py "$@"