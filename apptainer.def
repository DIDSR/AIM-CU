Bootstrap: docker
From: ubuntu:24.04

%environment
    export PATH="/usr/local/bin:$PATH"

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        software-properties-common \
        dirmngr \
        wget \
        ca-certificates \
        git \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv

    wget -qO /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc \
        https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc

    add-apt-repository -y \
        "deb https://cloud.r-project.org/bin/linux/ubuntu noble-cran40/"
    apt-get update
    apt-get install -y --no-install-recommends r-base r-base-dev

    # setup R configs
    echo "r <- getOption('repos'); r['CRAN'] <- 'https://cloud.r-project.org'; options(repos = r);" \
        >> /etc/R/Rprofile.site

    Rscript -e "install.packages(c('ggplot2', 'hexbin', 'lazyeval', 'cusumcharter', 'RcppCNPy', 'spc'))"

    # Clone the repository. If not, use local repository, and put this Dockerfile inside it and comment the below two commands
    cd /
    git clone https://github.com/DIDSR/AIM-CU.git /app

    cd /app/src/package
    python3 -m pip install --use-pep517 --no-cache-dir \
        --break-system-packages --upgrade -r /app/requirements.txt
    python3 -m pip install --no-cache-dir --break-system-packages \
        --upgrade gradio gradio_client

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    cd /app/src/package
    exec python3 app.py "$@"